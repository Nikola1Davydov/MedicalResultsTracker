<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MedicalResultsTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:view="clr-namespace:MedicalResultsTracker.View"
    Title="{x:Static loc:S.App_Title}">

    <TabBar>
        <ShellContent
            Title="{x:Static loc:S.Tab_Dashboard}"
            ContentTemplate="{DataTemplate view:MainPage}"
            Route="dashboard" />
        <ShellContent
            Title="{x:Static loc:S.Tab_Matrix}"
            ContentTemplate="{DataTemplate view:MatrixPage}"
            Route="matrix" />
        <ShellContent
            Title="{x:Static loc:S.Tab_History}"
            ContentTemplate="{DataTemplate view:HistoryPage}"
            Route="history" />
        <ShellContent
            Title="{x:Static loc:S.Tab_Trends}"
            ContentTemplate="{DataTemplate view:TrendsPage}"
            Route="trends" />
        <ShellContent
            Title="{x:Static loc:S.Tab_Settings}"
            ContentTemplate="{DataTemplate view:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
