<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MedicalResultsTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:MedicalResultsTracker.View"
    Title="MedicalResultsTracker">

    <TabBar>
        <ShellContent
            Title="Обзор"
            ContentTemplate="{DataTemplate view:MainPage}"
            Route="dashboard" />
        <ShellContent
            Title="История"
            ContentTemplate="{DataTemplate view:HistoryPage}"
            Route="history" />
        <ShellContent
            Title="Динамика"
            ContentTemplate="{DataTemplate view:TrendsPage}"
            Route="trends" />
        <ShellContent
            Title="Настройки"
            ContentTemplate="{DataTemplate view:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
