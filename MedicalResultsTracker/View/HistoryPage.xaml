<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:HistoryViewModel">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">

        <Label
            Grid.Row="0"
            IsVisible="{Binding IsEmpty}"
            Style="{StaticResource Caption}"
            Text="Здесь появятся все сохранённые анализы — по одному на каждую сдачу." />

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Tests}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TestListItemViewModel">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                                <BoxView Grid.Column="0" Color="{Binding StatusColor}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label FontAttributes="Bold" Text="{Binding Title}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">
            <Button
                Grid.Column="0"
                Command="{Binding AddCommand}"
                Text="➕ Внести анализ" />
            <Button
                Grid.Column="1"
                Command="{Binding ExportCommand}"
                Text="⬇ Выгрузить таблицу" />
        </Grid>

    </Grid>

</ContentPage>
