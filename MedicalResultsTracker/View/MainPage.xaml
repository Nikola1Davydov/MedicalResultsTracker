<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:MedicalResultsTracker.Controls"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:MainViewModel">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionTitle}" Text="{Binding LastTestTitle}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding Summary}" />
                    </VerticalStackLayout>
                </Border>

                <Button Command="{Binding AddTestCommand}" Text="{x:Static loc:S.Hist_Add}" />

                <!--  Давление записывают каждый день, поэтому оно на первом экране,
                      а не спрятано за вкладкой. Тап по карточке открывает весь дневник.  -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPressureCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Bp_Title}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="{Binding PressureSummary}"
                            TextColor="{Binding PressureColor}" />
                        <Button Command="{Binding AddPressureCommand}" Text="{x:Static loc:S.Bp_Add}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Пустое состояние: объясняем, что делать дальше.  -->
                <Border IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Dash_StartTitle}" />
                        <Label Text="{x:Static loc:S.Dash_StartBody}" />
                        <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Dash_StartNote}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Сводка вместо списка: сколько показателей вышло за норму и в какую
                      сторону. Перечислять их здесь незачем — за этим человек идёт
                      в «Динамику», где тот же список отбирается фильтрами.  -->
                <Border IsVisible="{Binding HasData}" Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTrendsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Dash_OutOfRange}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            IsVisible="{Binding HasHigh}"
                            Text="{Binding HighSummary}"
                            TextColor="{x:Static ctl:StatusPalette.High}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            IsVisible="{Binding HasLow}"
                            Text="{Binding LowSummary}"
                            TextColor="{x:Static ctl:StatusPalette.Low}" />
                        <Label
                            IsVisible="{Binding AllInRange}"
                            Text="{x:Static loc:S.Dash_NoneOut}"
                            TextColor="{x:Static ctl:StatusPalette.Normal}" />
                        <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Dash_OpenTrends}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasChanges}" Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Dash_Changes}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Changes}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrendItemViewModel">
                                <Border Style="{StaticResource Card}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenTrendCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label
                                                Style="{StaticResource Caption}"
                                                Text="{Binding AssessmentText}"
                                                TextColor="{Binding AssessmentColor}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"
                                                Text="{Binding Value}" />
                                            <Label
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding DeltaText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!--  Отправка в ИИ-чат живёт во вкладке «Динамика»: там видно все показатели
                      и есть фильтры, а отправлять осмысленно именно отобранное.  -->

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
