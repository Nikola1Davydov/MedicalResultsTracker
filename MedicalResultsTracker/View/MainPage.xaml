<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:MedicalResultsTracker.Controls"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:MainViewModel">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!--  Устроена так же, как карточка давления: тап по карточке открывает
                      весь список записей, кнопка внутри заводит новую. Раньше по анализам
                      попасть в список было нельзя вовсе, а по давлению — можно.  -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SectionTitle}" Text="{Binding LastTestTitle}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding Summary}" />
                        <Button Command="{Binding AddTestCommand}" Text="{x:Static loc:S.Hist_Add}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Давление записывают каждый день, поэтому оно на первом экране,
                      а не спрятано за вкладкой. Тап по карточке открывает весь дневник.  -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPressureCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Bp_Title}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="{Binding PressureSummary}"
                            TextColor="{Binding PressureColor}" />
                        <Button Command="{Binding AddPressureCommand}" Text="{x:Static loc:S.Bp_Add}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Пустое состояние: объясняем, что делать дальше.  -->
                <Border IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Dash_StartTitle}" />
                        <Label Text="{x:Static loc:S.Dash_StartBody}" />
                        <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Dash_StartNote}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Два квадрата вместо списка: сколько показателей вышло за норму вверх
                      и сколько вниз. Перечислять их здесь незачем — за этим человек идёт
                      в «Динамику», где тот же список отбирается фильтрами.  -->
                <Label
                    IsVisible="{Binding HasData}"
                    Style="{StaticResource SectionTitle}"
                    Text="{x:Static loc:S.Dash_OutOfRange}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding HasData}">
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTrendsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="34"
                                Text="{Binding HighCount}"
                                TextColor="{x:Static ctl:StatusPalette.High}" />
                            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Dash_HighTitle}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTrendsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="34"
                                Text="{Binding LowCount}"
                                TextColor="{x:Static ctl:StatusPalette.Low}" />
                            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Dash_LowTitle}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label
                    IsVisible="{Binding AllInRange}"
                    Text="{x:Static loc:S.Dash_NoneOut}"
                    TextColor="{x:Static ctl:StatusPalette.Normal}" />

                <Label
                    IsVisible="{Binding HasData}"
                    Style="{StaticResource Caption}"
                    Text="{x:Static loc:S.Dash_OpenTrends}" />

                <!--  Отправка в ИИ-чат живёт во вкладке «Динамика»: там видно все показатели
                      и есть фильтры, а отправлять осмысленно именно отобранное.  -->

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
