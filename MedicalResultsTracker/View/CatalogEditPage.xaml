<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.CatalogEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:model="clr-namespace:MedicalResultsTracker.Model"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:CatalogEditViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.CatEdit_Name}" />
                    <Entry Placeholder="{x:Static loc:S.CatEdit_NamePlaceholder}" Text="{Binding Name}" />

                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Csv_Unit}" />
                    <Entry Placeholder="{x:Static loc:S.CatEdit_UnitPlaceholder}" Text="{Binding Unit}" />

                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.CatEdit_Group}" />
                    <Picker
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        Title="{x:Static loc:S.CatEdit_GroupPick}" />
                    <Entry Placeholder="{x:Static loc:S.CatEdit_GroupNew}" Text="{Binding Category}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Edit_RowRefMin}" />
                            <Entry Keyboard="Numeric" Text="{Binding RefMinText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Edit_RowRefMax}" />
                            <Entry Keyboard="Numeric" Text="{Binding RefMaxText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.CatEdit_Notes}" />
                    <Entry Placeholder="{x:Static loc:S.CatEdit_NotesPlaceholder}" Text="{Binding Notes}" />

                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.CatEdit_Note}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsExisting}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Caption}" Text="{Binding CodeText}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding UsageText}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{x:Static loc:S.CatEdit_Favorite}" />
                            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.CatEdit_FavoriteNote}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsFavorite}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{x:Static loc:S.CatEdit_Hide}" />
                            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.CatEdit_HideNote}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsHidden}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsExisting}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.CatEdit_MergeTitle}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.CatEdit_MergeBody}" />
                    <Picker
                        ItemDisplayBinding="{Binding Name, x:DataType=model:Analyte}"
                        ItemsSource="{Binding MergeTargets}"
                        SelectedItem="{Binding MergeTarget}"
                        Title="{x:Static loc:S.CatEdit_MergeTarget}" />
                    <Button Command="{Binding MergeCommand}" Text="{x:Static loc:S.CatEdit_Merge}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    Command="{Binding SaveCommand}"
                    Text="{x:Static loc:S.Common_Save}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding CancelCommand}"
                    Text="{x:Static loc:S.Common_Cancel}" />
                <Button
                    Grid.Column="2"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsExisting}"
                    Text="🗑" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
