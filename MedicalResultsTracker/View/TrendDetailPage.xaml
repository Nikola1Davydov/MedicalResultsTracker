<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.TrendDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:MedicalResultsTracker.Controls"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:TrendDetailViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding RangeText}" />
                    <!--  Значения в разных единицах несравнимы: об этом надо сказать прямо над графиком.  -->
                    <Label
                        FontAttributes="Bold"
                        IsVisible="{Binding HasMixedUnits}"
                        Text="{x:Static loc:S.Trend_MixedUnits}"
                        TextColor="{x:Static ctl:StatusPalette.High}" />
                    <GraphicsView
                        Drawable="{Binding Chart}"
                        HeightRequest="220"
                        IsVisible="{Binding HasData}"
                        SemanticProperties.Description="{x:Static loc:S.A11y_TrendChart}" />
                </VerticalStackLayout>
            </Border>

            <!--  Норму и склейку правят там, где человек видит проблему: он смотрит на
                  этот график, а не на справочник в настройках.  -->
            <Button
                Command="{Binding EditRangeCommand}"
                IsVisible="{Binding HasData}"
                Text="{x:Static loc:S.Trend_EditRange}" />

            <Border IsVisible="{Binding IsEditingRange}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Trend_RangeHint}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Edit_RowRefMin}" />
                            <Entry Keyboard="Numeric" Text="{Binding RefMinText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Edit_RowRefMax}" />
                            <Entry Keyboard="Numeric" Text="{Binding RefMaxText}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Grid.Column="0"
                            Command="{Binding SaveRangeCommand}"
                            Text="{x:Static loc:S.Common_Save}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding CancelRangeCommand}"
                            Text="{x:Static loc:S.Common_Cancel}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button
                Command="{Binding MergeCommand}"
                IsVisible="{Binding HasData}"
                Text="{x:Static loc:S.CatEdit_MergeTitle}" />

            <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Trend_Values}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Values}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeriesRowViewModel">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding DateText}"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        Text="{Binding ValueText}"
                                        TextColor="{Binding StatusColor}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding StatusText}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding DeltaText}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
