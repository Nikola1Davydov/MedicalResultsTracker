<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.TrendDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:TrendDetailViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding RangeText}" />
                    <GraphicsView
                        Drawable="{Binding Chart}"
                        HeightRequest="220"
                        IsVisible="{Binding HasData}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Trend_Values}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Values}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeriesRowViewModel">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding DateText}"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        Text="{Binding ValueText}"
                                        TextColor="{Binding StatusColor}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding StatusText}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding DeltaText}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
