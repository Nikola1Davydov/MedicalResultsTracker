<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.TestEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:model="clr-namespace:MedicalResultsTracker.Model"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:TestEditViewModel">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Edit_Date}" />
                        <!--  «d» — короткая дата языка интерфейса, а не немецкая навсегда.  -->
                        <DatePicker Date="{Binding Date}" Format="d" />

                        <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Edit_Lab}" />
                        <Entry Placeholder="{x:Static loc:S.Edit_LabPlaceholder}" Text="{Binding Laboratory}" />

                        <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Edit_Note}" />
                        <Entry Placeholder="{x:Static loc:S.Edit_NotePlaceholder}" Text="{Binding Notes}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Edit_AddParam}" />
                        <SearchBar Placeholder="{x:Static loc:S.Edit_SearchPlaceholder}" Text="{Binding AnalyteQuery}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="model:Analyte">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TestEditViewModel}}, Path=AddAnalyteCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label
                                            Grid.Column="0"
                                            Padding="0,8"
                                            Text="{Binding Name}" />
                                        <Label
                                            Grid.Column="1"
                                            Padding="0,8"
                                            Style="{StaticResource Caption}"
                                            Text="{Binding Unit}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Command="{Binding AddTypedNameCommand}"
                                Text="{x:Static loc:S.Edit_AddTyped}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding AddRowCommand}"
                                Text="{x:Static loc:S.Edit_AddEmpty}" />
                        </Grid>
                        <Button Command="{Binding CopyFromPreviousCommand}" Text="{x:Static loc:S.Edit_CopyPrevious}" />
                        <Label
                            IsVisible="{Binding HasAssistantHint}"
                            Style="{StaticResource Caption}"
                            Text="{Binding AssistantHint}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Edit_PhotoTitle}" />
                        <Label Text="{x:Static loc:S.Edit_PhotoBody}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Command="{Binding CopyImportPromptCommand}"
                                Text="{x:Static loc:S.Edit_CopyPrompt}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding PasteRowsCommand}"
                                Text="{x:Static loc:S.Edit_Paste}" />
                        </Grid>
                        <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Edit_PhotoNote}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParameterRowViewModel">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Entry
                                            Grid.Column="0"
                                            Placeholder="{x:Static loc:S.Edit_RowName}"
                                            Text="{Binding Name}" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TestEditViewModel}}, Path=RemoveRowCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{x:Static loc:S.A11y_RemoveRow}"
                                            Text="✕"
                                            WidthRequest="48" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Entry
                                            Grid.Column="0"
                                            Keyboard="Numeric"
                                            Placeholder="{x:Static loc:S.Csv_Value}"
                                            Text="{Binding ValueText}" />
                                        <Entry
                                            Grid.Column="1"
                                            Placeholder="{x:Static loc:S.Csv_Unit}"
                                            Text="{Binding Unit}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Entry
                                            Grid.Column="0"
                                            Keyboard="Numeric"
                                            Placeholder="{x:Static loc:S.Edit_RowRefMin}"
                                            Text="{Binding RefMinText}" />
                                        <Entry
                                            Grid.Column="1"
                                            Keyboard="Numeric"
                                            Placeholder="{x:Static loc:S.Edit_RowRefMax}"
                                            Text="{Binding RefMaxText}" />
                                    </Grid>
                                    <Label
                                        Style="{StaticResource Caption}"
                                        Text="{Binding StatusText}"
                                        TextColor="{Binding StatusColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource Caption}"
                    Text="{x:Static loc:S.Edit_Hint}" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid
            Grid.Row="1"
            Padding="16,8"
            ColumnDefinitions="*,*,Auto"
            ColumnSpacing="10">
            <Button
                Grid.Column="0"
                Command="{Binding SaveCommand}"
                Text="{x:Static loc:S.Common_Save}" />
            <Button
                Grid.Column="1"
                Command="{Binding CancelCommand}"
                Text="{x:Static loc:S.Common_Cancel}" />
            <Button
                Grid.Column="2"
                Command="{Binding DeleteCommand}"
                IsVisible="{Binding IsExisting}"
                SemanticProperties.Description="{x:Static loc:S.Common_Delete}"
                Text="🗑" />
        </Grid>

    </Grid>

</ContentPage>
