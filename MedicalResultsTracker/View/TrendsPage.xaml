<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.TrendsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:TrendsViewModel">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label
                IsVisible="{Binding IsEmpty}"
                Style="{StaticResource Caption}"
                Text="Графики появятся, когда в истории будет хотя бы два анализа с одинаковыми показателями." />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    Command="{Binding ToggleFavoritesFilterCommand}"
                    Text="★ Только избранное" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ToggleHistoryFilterCommand}"
                    Text="Все / с историей" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy}">
            <CollectionView
                IsGrouped="True"
                ItemsSource="{Binding Groups}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:SeriesGroupViewModel">
                        <VerticalStackLayout Padding="0,12,0,4" Spacing="0">
                            <Label Style="{StaticResource SectionTitle}" Text="{Binding Name}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeriesItemViewModel">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrendsViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label FontAttributes="Bold" Text="{Binding Name}" />
                                    <Label Text="{Binding LatestText}" TextColor="{Binding StatusColor}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding DeltaText}" />
                                </VerticalStackLayout>
                                <GraphicsView
                                    Grid.Column="1"
                                    Drawable="{Binding Chart}"
                                    HeightRequest="56" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
