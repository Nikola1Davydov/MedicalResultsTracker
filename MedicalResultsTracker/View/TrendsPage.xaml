<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.TrendsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:MedicalResultsTracker.Controls"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:TrendsViewModel">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <!--  Поиск, фильтр и отправка в чат — одной строкой. Кнопки круглые и одного
                  размера: рядом с полем ввода они читаются как значки, а не как надписи,
                  и не растягивают строку, сколько бы фильтров ни добавилось потом.  -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <SearchBar
                    Grid.Column="0"
                    Placeholder="{x:Static loc:S.Trend_Search}"
                    Text="{Binding Search}" />
                <Button
                    Grid.Column="1"
                    Padding="0"
                    Command="{Binding FilterCommand}"
                    CornerRadius="22"
                    FontSize="18"
                    HeightRequest="44"
                    SemanticProperties.Description="{x:Static loc:S.A11y_Filter}"
                    Text="{Binding FilterGlyph}"
                    VerticalOptions="Center"
                    WidthRequest="44" />
                <Button
                    Grid.Column="2"
                    Padding="0"
                    Command="{Binding CopyForAiCommand}"
                    CornerRadius="22"
                    FontSize="18"
                    HeightRequest="44"
                    SemanticProperties.Description="{x:Static loc:S.A11y_Ai}"
                    Text="🤖"
                    VerticalOptions="Center"
                    WidthRequest="44" />
            </Grid>

            <Label
                IsVisible="{Binding HasFilterSummary}"
                Style="{StaticResource Caption}"
                Text="{Binding FilterSummary}" />

            <Label
                IsVisible="{Binding IsEmpty}"
                Style="{StaticResource Caption}"
                Text="{x:Static loc:S.Trend_Empty}" />

            <Label
                IsVisible="{Binding IsFilteredOut}"
                Style="{StaticResource Caption}"
                Text="{x:Static loc:S.Trend_NothingFound}" />
        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <CollectionView
                IsGrouped="True"
                ItemsSource="{Binding Groups}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:SeriesGroupViewModel">
                        <VerticalStackLayout Padding="0,12,0,4" Spacing="0">
                            <Label Style="{StaticResource SectionTitle}" Text="{Binding Name}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeriesItemViewModel">
                        <!--  Жест вправо — избранное, влево — убрать из списка. Mode="Execute":
                              действие происходит по самому жесту, без второго нажатия
                              по открывшейся кнопке, — как в почте.

                              Команды берутся у самой карточки: внутри SwipeItem поиск
                              родительской ViewModel по дереву работает ненадёжно.  -->
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem
                                        BackgroundColor="{x:Static ctl:StatusPalette.FilterOn}"
                                        Command="{Binding FavoriteCommand}"
                                        CommandParameter="{Binding .}"
                                        Text="{Binding FavoriteActionText}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem
                                        BackgroundColor="{x:Static ctl:StatusPalette.FilterOff}"
                                        Command="{Binding HideCommand}"
                                        CommandParameter="{Binding .}"
                                        Text="{x:Static loc:S.Swipe_Hide}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrendsViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label FontAttributes="Bold" Text="{Binding Name}" />
                                        <Label Text="{Binding LatestText}" TextColor="{Binding StatusColor}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding DeltaText}" />
                                    </VerticalStackLayout>
                                    <GraphicsView
                                        Grid.Column="1"
                                        Drawable="{Binding Chart}"
                                        HeightRequest="56"
                                        SemanticProperties.Description="{x:Static loc:S.A11y_TrendChart}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <!--  Под списком остаётся только строчка о том, включён ли ИИ-помощник.
                          Само действие — кнопкой рядом с поиском: карточка на полэкрана
                          под каждым списком мешала читать сам список.  -->
                    <Label
                        Margin="0,14,0,0"
                        Style="{StaticResource Caption}"
                        Text="{Binding AssistantStatus}" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
