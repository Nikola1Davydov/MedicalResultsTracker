<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.MatrixPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding Title}"
    x:DataType="vm:MatrixViewModel">

    <!--  Заголовка нет намеренно: вкладка внизу и так называется «Таблица»,
          а на этом экране каждая строка по вертикали на счету.  -->
    <Grid Padding="12,8" RowDefinitions="Auto,*" RowSpacing="8">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <!--  Единственный орган управления: выбор набора и он же вход в его правку.
                  Кнопки рядом с ним съедали ширину и место, ради которого таблица и делалась.  -->
            <Picker
                ItemDisplayBinding="{Binding Name, x:DataType=vm:MatrixViewOption}"
                ItemsSource="{Binding Views}"
                SelectedItem="{Binding SelectedView}" />
            <Label
                IsVisible="{Binding IsEmpty}"
                Style="{StaticResource Caption}"
                Text="{x:Static loc:S.Matrix_Empty}" />
        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <ScrollView Orientation="Vertical">
                <!--  Названия показателей стоят на месте, значения уезжают вправо:
                      без этого при десятке сдач непонятно, чья это строка.  -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="0">
                    <Grid x:Name="FixedColumn" Grid.Column="0" />
                    <ScrollView Grid.Column="1" Orientation="Horizontal">
                        <Grid x:Name="ScrollingColumns" />
                    </ScrollView>
                </Grid>
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
