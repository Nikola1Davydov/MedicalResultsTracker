<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.MatrixPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
    xmlns:components="clr-namespace:MedicalResultsTracker.Components"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    Shell.NavBarIsVisible="False"
    Title="{x:Static loc:S.Tab_Matrix}">

    <!--  Заголовка нет намеренно: вкладка внизу и так называется «Таблица»,
          а на этом экране каждая строка по вертикали на счету.  -->
    <blazor:BlazorWebView HostPage="wwwroot/index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent ComponentType="{x:Type components:MatrixTable}" Selector="#app" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>

</ContentPage>
