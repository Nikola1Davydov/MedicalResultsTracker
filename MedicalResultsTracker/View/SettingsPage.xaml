<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:MedicalResultsTracker.Controls"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:SettingsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_LanguageTitle}" />
                    <Picker
                        ItemDisplayBinding="{Binding Name, x:DataType=loc:LanguageOption}"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_LanguageNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_StorageTitle}" />
                    <Label Text="{Binding StorageSummary}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_DbFile}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding DatabasePath}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Bp_Title}" />
                    <!--  Порог задаёт человек со слов врача: приложение сравнивает с числом,
                          а не ставит степень гипертонии.  -->
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Bp_TargetBody}" />
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <Entry
                            Grid.Column="0"
                            HorizontalTextAlignment="Center"
                            Keyboard="Numeric"
                            MaxLength="3"
                            Text="{Binding PressureTargetSystolic}" />
                        <Label
                            Grid.Column="1"
                            Text="/"
                            VerticalOptions="Center" />
                        <Entry
                            Grid.Column="2"
                            HorizontalTextAlignment="Center"
                            Keyboard="Numeric"
                            MaxLength="3"
                            Text="{Binding PressureTargetDiastolic}" />
                    </Grid>
                    <Button Command="{Binding SavePressureTargetCommand}" Text="{x:Static loc:S.Bp_TargetSave}" />
                    <Button Command="{Binding OpenPressureCommand}" Text="{x:Static loc:S.Bp_OpenDiary}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_CatalogTitle}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_CatalogBody}" />
                    <Button Command="{Binding OpenCatalogCommand}" Text="{x:Static loc:S.Set_CatalogOpen}" />
                </VerticalStackLayout>
            </Border>

            <!--  Выгрузка — это «показать данные снаружи»: таблица для врача, список
                  для сводной таблицы. К сохранению истории она отношения не имеет.  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_ExportTitle}" />
                    <Button Command="{Binding ExportMatrixCommand}" Text="{x:Static loc:S.Set_ExportMatrix}" />
                    <Button Command="{Binding ExportFlatCommand}" Text="{x:Static loc:S.Set_ExportFlat}" />
                    <Button Command="{Binding ExportPressureCommand}" Text="{x:Static loc:S.Set_ExportPressure}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_ExportNote}" />
                </VerticalStackLayout>
            </Border>

            <!--  Резервная копия и автоматическая копия — одно и то же действие, просто
                  второе происходит без нажатия. Поэтому они в одной карточке: данные
                  живут только на этом устройстве, и копия — единственное, что переживёт
                  телефон.  -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_BackupTitle}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding BackupSummary}" />
                    <Label
                        IsVisible="{Binding BackupOverdue}"
                        Text="{x:Static loc:S.Set_BackupOverdue}"
                        TextColor="{x:Static ctl:StatusPalette.High}" />
                    <Button Command="{Binding ExportBackupCommand}" Text="{x:Static loc:S.Set_ExportBackup}" />
                    <Button Command="{Binding ImportBackupCommand}" Text="{x:Static loc:S.Set_ImportBackup}" />

                    <BoxView Color="{x:Static ctl:StatusPalette.Axis}" HeightRequest="1" />

                    <!--  Приложение только пишет файл в выбранную папку; синхронизирует ли
                          её облако — дело того приложения, которое синхронизирует.  -->
                    <Label FontAttributes="Bold" Text="{x:Static loc:S.Auto_Title}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Auto_Body}" />
                    <Label Text="{Binding AutoBackupSummary}" />
                    <Button Command="{Binding ChooseBackupFolderCommand}" Text="{x:Static loc:S.Auto_ChooseFolder}" />
                    <Button
                        Command="{Binding BackupToFolderNowCommand}"
                        IsVisible="{Binding HasAutoBackupFolder}"
                        Text="{x:Static loc:S.Auto_Now}" />
                    <Button
                        Command="{Binding ForgetBackupFolderCommand}"
                        IsVisible="{Binding HasAutoBackupFolder}"
                        Text="{x:Static loc:S.Auto_Forget}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_DangerTitle}" />
                    <Button Command="{Binding DeleteAllDataCommand}" Text="{x:Static loc:S.Set_DeleteAll}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_AboutTitle}" />
                    <Label Text="{Binding VersionSummary}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_AboutBody}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_Disclaimer}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
