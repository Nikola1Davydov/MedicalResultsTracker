<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MedicalResultsTracker.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MedicalResultsTracker.Resources.Strings"
    xmlns:vm="clr-namespace:MedicalResultsTracker.ViewModel"
    Title="{Binding Title}"
    x:DataType="vm:SettingsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_LanguageTitle}" />
                    <Picker
                        ItemDisplayBinding="{Binding Name, x:DataType=loc:LanguageOption}"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_LanguageNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_StorageTitle}" />
                    <Label Text="{Binding StorageSummary}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_DbFile}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding DatabasePath}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_CatalogTitle}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_CatalogBody}" />
                    <Button Command="{Binding OpenCatalogCommand}" Text="{x:Static loc:S.Set_CatalogOpen}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_ExportTitle}" />
                    <Button Command="{Binding ExportMatrixCommand}" Text="{x:Static loc:S.Set_ExportMatrix}" />
                    <Button Command="{Binding ExportFlatCommand}" Text="{x:Static loc:S.Set_ExportFlat}" />
                    <Button Command="{Binding ExportBackupCommand}" Text="{x:Static loc:S.Set_ExportBackup}" />
                    <Button Command="{Binding ImportBackupCommand}" Text="{x:Static loc:S.Set_ImportBackup}" />
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_ExportNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_AiTitle}" />
                    <Label Text="{x:Static loc:S.Set_AiBody}" />

                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_AiManual}" />
                    <Button Command="{Binding ShareForAiCommand}" Text="{x:Static loc:S.Set_AiShare}" />
                    <Button Command="{Binding CopyForAiCommand}" Text="{x:Static loc:S.Set_AiCopy}" />

                    <!--  Переключателей согласия здесь нет намеренно: провайдер не подключён,
                          и тумблер, который ничего не переключает, — худший вид интерфейса.
                          Механизм согласия (IAiConsentService) остаётся в коде и вернётся
                          на экран вместе с провайдером.  -->
                    <Label Style="{StaticResource Caption}" Text="{Binding AssistantSummary}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="{x:Static loc:S.Set_DangerTitle}" />
                    <Button Command="{Binding DeleteAllDataCommand}" Text="{x:Static loc:S.Set_DeleteAll}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource Caption}" Text="{x:Static loc:S.Set_Disclaimer}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
